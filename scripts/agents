#!/bin/bash
# Read-only discovery. Installer stubs are not installed agents.
set -euo pipefail
script_dir=$(dirname -- "$(readlink -f -- "$0")")
install_bases=()
if command -v mise >/dev/null; then
  installed=$(MISE_OFFLINE=1 mise ls --installed --json) || exit 1
  mapfile -t install_bases < <(jq -r '[.[][]] | sort_by(.active // false) | reverse | .[].install_path' <<< "$installed")
fi
installed_binary() {
  local candidate=$1 target
  [[ $candidate != */mise/shims/* && $candidate != */command-wrappers/* ]] || return 1
  [[ -f $candidate && -x $candidate ]] || return 1
  target=$(readlink -f -- "$candidate") || return 1
  [[ $target != */mise/shims/* && $target != */command-wrappers/* ]] || return 1
  if grep -Iq . "$target" && grep -Eq 'mise[[:space:]]+(use|x|exec|install)([[:space:]]|$)|omarchy-install-.*--now' "$target"; then return 1; fi
}
resolve() {
  local executable=$1 tool=$2 candidate base
  # Prefer real user/system executables over mise's first-run installers.
  while IFS= read -r candidate; do
    installed_binary "$candidate" && { printf '%s\n' "$candidate"; return; }
  done < <(type -aP "$executable" 2>/dev/null || true)
  candidate="$HOME/.local/bin/$executable"
  installed_binary "$candidate" && { printf '%s\n' "$candidate"; return; }
  for base in "${install_bases[@]}"; do
    # npm-backed mise tools install their executable under node_modules/.bin.
    for candidate in "$base/bin/$executable" "$base/$executable" "$base/node_modules/.bin/$executable"; do
      installed_binary "$candidate" && { printf '%s\n' "$candidate"; return; }
    done
  done
  return 1
}
rows=()
# Catalog columns: executable | label | mise tool | Omarchy agent mark (empty: generic icon).
while IFS='|' read -r executable label tool mark; do
  if [[ ${1:-} == --resolve && ${2:-} != "$executable" ]]; then continue; fi
  if binary=$(resolve "$executable" "$tool"); then
    if [[ ${1:-} == --resolve ]]; then printf '%s\n' "$binary"; exit 0; fi
    icon=${mark:-agents}
    rows+=("$(jq -cn --arg label "$label" --arg icon "$icon" --arg helper "$script_dir/agent" --arg id "$executable" \
      '{label:$label,icon:$icon,command:["omarchy","launch","tui","--app-id=org.omarchy.agent",$helper,$id]}')")
  fi
done <<'CATALOG'
claude|Claude Code|claude|claude
codex|Codex|codex|codex
grok|Grok|grok|grok
opencode|OpenCode|opencode|opencode
pi|Pi|pi|
omp|Oh My Pi|github:can1357/oh-my-pi|
ori|Ori|github:OpenRouterLabs/ori-releases|
agy|Antigravity|antigravity-cli|agy
copilot|GitHub Copilot|copilot|copilot
crush|Crush|crush|
cursor-agent|Cursor CLI|cursor-agent|cursor
muse|Muse Code|muse|muse
kimi|Kimi|npm:@moonshot-ai/kimi-code|kimi
hermes|Hermes|hermes|hermes
openclaw|OpenClaw|openclaw|
qwen|Qwen Code|qwen|qwen
dsh|DeepSeek Harness|npm:@deepseek-ai/dsh|deepseek
mcode|MiniMax Code|npm:@minimax-ai/code|minimax
kiro-cli|Kiro CLI|http:kiro-cli|
freebuff|Freebuff|npm:freebuff|
kilo|Kilo|npm:@kilocode/cli|
devin|Devin CLI|http:devin|devin
amp|Amp|amp|
commandcode|Command Code|npm:command-code|
CATALOG
[[ ${1:-} != --resolve ]] || exit 1
printf '%s\n' "${rows[@]}" | jq -s .
