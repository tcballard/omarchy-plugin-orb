#!/usr/bin/env bash
set -euo pipefail

fail() { jq -cn --arg error "$1" '{ok:false,error:$error}'; exit 1; }
bounded() {
  local data
  data=$(timeout --kill-after=1 4 "$@" 2>/dev/null | head -c 1048577) || return 1
  (( ${#data} <= 1048576 )) || return 1
  printf '%s' "$data"
}
json() { local data; data=$(bounded "$@") && jq -ce . <<<"$data"; }
done_ok() { printf '{"ok":true}\n'; }
plugins() { json omarchy-shell shell listPlugins; }
enabled() { jq -e --arg id "$1" 'any(.[]; .id == $id and .enabled == true)' <<<"$catalog" >/dev/null; }
provider="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/andreiyurik.tablet-mode/bin/omarchy-tablet-mode"
keyboard() {
  local preference=$1 verb=$2 result
  [[ $preference == auto || $preference == omatouch || $preference == tablet ]] || fail 'Unknown keyboard provider.'
  [[ $verb == show || $verb == hide ]] || fail 'Unknown keyboard action.'
  catalog=$(plugins) || fail 'Could not discover enabled plugins.'
  if [[ $preference != tablet ]] && enabled m44f4.omatouch; then
    command -v wtype >/dev/null || fail 'OmaTouch needs the wtype package.'
    if [[ $verb == show ]]; then
      bounded omarchy-shell shell hide m44f4.omatouch >/dev/null || fail 'Could not hide the keyboard before raising it.'
      result=$(bounded omarchy-shell shell summon m44f4.omatouch '{}') || fail 'Could not show OmaTouch.'
      [[ $result == ok ]] || fail 'OmaTouch is not available from the current bar.'
    else
      bounded omarchy-shell shell hide m44f4.omatouch >/dev/null || fail 'Could not hide OmaTouch.'
    fi
  elif [[ $preference != omatouch && -x $provider ]] && enabled andreiyurik.tablet-mode; then
    local state
    state=$(json "$provider" status) || fail 'Tablet Mode could not report its keyboard.'
    jq -e '.keyboard | type == "string" and length > 0' <<<"$state" >/dev/null || fail 'Enable an on-screen keyboard for Tablet Mode first.'
    if [[ $verb == show ]]; then bounded "$provider" keyboard hide >/dev/null || true; fi
    bounded "$provider" keyboard "$verb" >/dev/null || fail 'Tablet Mode could not control its keyboard.'
  else
    fail 'Enable OmaTouch or a keyboard supported by Tablet Mode, then retry.'
  fi
  done_ok
}
known_monitor() {
  [[ ${#1} -le 128 && -n $1 && $1 != *$'\n'* ]] || fail 'Choose a connected display.'
  local monitors
  monitors=$(json hyprctl -j monitors) || fail 'Could not read displays.'
  jq -e --arg name "$1" 'any(.[]; .name == $name and .disabled != true)' <<<"$monitors" >/dev/null || fail 'The selected display is no longer connected.'
}
known_window() {
  [[ $1 =~ ^0x[0-9a-fA-F]{1,16}$ ]] || fail 'Invalid window address.'
  local clients
  clients=$(json hyprctl -j clients) || fail 'Could not read windows.'
  jq -e --arg address "$1" 'any(.[]; .address == $address and .mapped != false)' <<<"$clients" >/dev/null || fail 'That window has already closed.'
  window_workspace=$(jq -r --arg address "$1" '.[] | select(.address == $address) | .workspace.name // ""' <<<"$clients")
}
dispatch() {
  local reply
  reply=$(bounded hyprctl dispatch "$1") || fail 'Hyprland could not perform that action.'
  [[ $reply == ok ]] || fail 'Hyprland rejected that action.'
}
bring_forward() {
  local address=$1 output=${2:-} monitors workspace
  if [[ $window_workspace == special:minimized ]]; then
    [[ -n $output ]] || fail 'Choose a display before restoring a minimized window.'
    known_monitor "$output"
    monitors=$(json hyprctl -j monitors) || fail 'Could not read displays.'
    workspace=$(jq -r --arg name "$output" '.[] | select(.name == $name) | .activeWorkspace.id' <<<"$monitors")
    [[ $workspace =~ ^[1-9][0-9]{0,8}$ ]] || fail 'The display has no available workspace.'
    dispatch "hl.dsp.window.move({ workspace = \"$workspace\", window = \"address:$address\", follow = false })"
  fi
  dispatch "hl.dsp.focus({ window = \"address:$address\" })"
  dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:$address\" })"
}

monitor_geometry() {
  known_monitor "$1"
  local data
  data=$(json hyprctl -j monitors) || fail 'Could not read displays.'
  read -r mx my mw mh ml mt mr mb monitor_id active_workspace < <(jq -r --arg name "$1" '.[]|select(.name==$name)|(.scale // 1) as $s|(.transform // 0) as $t|[.x,.y,((if ($t%2)==1 then .height else .width end)/$s|floor),((if ($t%2)==1 then .width else .height end)/$s|floor),(.reserved[0]//0),(.reserved[1]//0),(.reserved[2]//0),(.reserved[3]//0),.id,.activeWorkspace.id]|@tsv' <<<"$data")
  for number in "$mx" "$my" "$mw" "$mh" "$ml" "$mt" "$mr" "$mb" "$monitor_id" "$active_workspace"; do
    [[ $number =~ ^-?[0-9]{1,9}$ ]] || fail 'Display geometry is unavailable.'
  done
  gx=$((mx+ml+8)); gy=$((my+mt+8)); gw=$((mw-ml-mr-16)); gh=$((mh-mt-mb-16))
  (( gw >= 240 && gh >= 160 && active_workspace > 0 )) || fail 'The display is too small or has no active workspace.'
}
place_window() {
  local address=$1 x=$2 y=$3 w=$4 h=$5 workspace=$6
  known_window "$address"
  dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"unset\", window = \"address:$address\" })"
  dispatch "hl.dsp.window.move({ workspace = \"$workspace\", follow = false, window = \"address:$address\" })"
  dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$address\" })"
  dispatch "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$address\" })"
  dispatch "hl.dsp.window.move({ x = $x, y = $y, relative = false, window = \"address:$address\" })"
}

command=${1:-status}; shift || true
case "$command" in
search)
  catalog=$(plugins) || fail 'Could not discover enabled plugins.'
  enabled typecraft.oma-cast || fail 'Enable Oma-Cast to use Search.'
  reply=$(bounded omarchy-shell oma-cast ping) || fail 'Oma-Cast did not respond.'
  [[ $reply == ok ]] || fail 'Oma-Cast is not ready.'
  bounded omarchy-shell oma-cast show >/dev/null || fail 'Could not open Oma-Cast.'
  done_ok
  ;;
pair)
  [[ $# == 4 && $1 != "$2" && $4 =~ ^(30|40|50|60|70)$ ]] || fail 'Choose two different windows and a split ratio.'
  first=$1; second=$2; ratio=$4
  known_window "$first"; known_window "$second"; monitor_geometry "$3"
  left=$(( (gw-8)*ratio/100 )); right=$((gw-8-left))
  place_window "$first" "$gx" "$gy" "$left" "$gh" "$active_workspace"
  place_window "$second" "$((gx+left+8))" "$gy" "$right" "$gh" "$active_workspace"
  dispatch "hl.dsp.focus({ window = \"address:$first\" })"; done_ok
  ;;
setup)
  [[ $# == 2 && $1 =~ ^[a-z0-9][a-z0-9_-]{0,47}$ ]] || fail 'Choose a saved work setup.'
  config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/orb.json"
  [[ -f $config && $(stat -Lc %s "$config") -le 1048576 ]] || fail 'Could not read Orb settings.'
  setup=$(jq -ce --arg id "$1" '.setups[] | select(.id==$id)' "$config") || fail 'That work setup no longer exists.'
  jq -e '(.workspace|type=="number" and floor==. and .>=1 and .<=9999) and (.layout=="tiled" or .layout=="columns") and (.apps|type=="array" and length>0 and length<=8 and all(.[];type=="string" and test("^[A-Za-z0-9_][A-Za-z0-9_.@+-]{0,254}$")))' <<<"$setup" >/dev/null || fail 'Invalid work setup.'
  mapfile -t apps < <(jq -r '.apps[]' <<<"$setup")
  IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for app in "${apps[@]}"; do
    found=false
    for dir in "${data_dirs[@]}"; do [[ ! -f $dir/applications/$app.desktop ]] || found=true; done
    [[ $found == true ]] || fail "Missing installed app: $app"
  done
  monitor_geometry "$2"
  ws=$(jq -r .workspace <<<"$setup"); layout=$(jq -r .layout <<<"$setup")
  spaces=$(json hyprctl -j workspaces) || fail 'Could not read workspaces.'
  jq -e --argjson id "$ws" --arg output "$2" 'all(.[]; .id!=$id or .monitor==$output)' <<<"$spaces" >/dev/null || fail 'That workspace belongs to another display.'
  (( ${#apps[@]} <= gw/120 )) || [[ $layout == tiled ]] || fail 'Use fewer apps for columns on this display.'
  dispatch "hl.dsp.focus({ monitor = $monitor_id })"
  dispatch "hl.dsp.focus({ workspace = \"$ws\", on_current_monitor = true })"
  index=0; count=${#apps[@]}
  for app in "${apps[@]}"; do
    rules="workspace = \"$ws silent\", monitor = \"$monitor_id\""
    if [[ $layout == columns ]]; then
      width=$(( (gw-8*(count-1))/count )); x=$((ml+8+index*(width+8))); y=$((mt+8))
      rules+=", floating = true, size = { $width, $gh }, move = { $x, $y }"
    fi
    dispatch "hl.dsp.exec_cmd(\"setsid uwsm-app -- gtk-launch '$app.desktop'\", { $rules })"
    index=$((index+1))
  done
  done_ok
  ;;
status|mode)
  catalog=$(plugins) || fail 'Could not discover enabled plugins.'
  tablet=false; state='{}'; tablet_error=''; keyboard_id=''; keyboard_ready=false
  if enabled andreiyurik.tablet-mode && [[ -x $provider ]]; then
    tablet=true
    state=$(json "$provider" status) || { state='{}'; tablet_error='Tablet Mode status is unavailable.'; }
  fi
  if enabled m44f4.omatouch; then
    keyboard_id=omatouch
    if command -v wtype >/dev/null; then keyboard_ready=true; fi
  elif [[ $tablet == true ]] && jq -e '.keyboard | type == "string" and length > 0' <<<"$state" >/dev/null; then
    keyboard_id=tablet; keyboard_ready=true
  fi
  jq -cn --argjson tablet "$tablet" --argjson status "$state" --arg error "$tablet_error" \
    --arg keyboard "$keyboard_id" --argjson keyboardReady "$keyboard_ready" \
    --argjson audio "$(command -v wpctl >/dev/null && echo true || echo false)" \
    --argjson media "$(command -v playerctl >/dev/null && echo true || echo false)" \
    --argjson network "$(enabled omarchy.network && echo true || echo false)" \
    --argjson brightness "$(command -v omarchy-brightness-display >/dev/null && echo true || echo false)" \
    '{ok:true,tabletEnabled:$tablet,hasFoldSensor:($status.hasFoldSensor == true),
      folded:(if ($status.folded|type)=="boolean" then $status.folded else null end),
      rotationLocked:($status.locked == true),tabletError:$error,keyboard:$keyboard,
      keyboardReady:$keyboardReady,audio:$audio,media:$media,network:$network,brightness:$brightness}'
  ;;
windows)
  rows=$(json hyprctl -j clients) || fail 'Could not read windows.'
  workspaces=$(json hyprctl -j workspaces) || fail 'Could not read workspaces.'
  jq -cn --argjson rows "$rows" --argjson workspaces "$workspaces" '{ok:true,windows:$rows,workspaces:[$workspaces[]|select(.id > 0)|{id,name,monitor}]}'
  ;;
keyboard) [[ $# == 2 ]] || fail 'Choose a keyboard and action.'; keyboard "$1" "$2" ;;
window)
  [[ $# -ge 2 && $# -le 3 ]] || fail 'Choose a window action.'
  action=$1; address=$2; known_window "$address"
  case "$action" in
  focus) bring_forward "$address" "${3:-}" ;;
  close) dispatch "hl.dsp.window.close({ window = \"address:$address\" })" ;;
  maximize) bring_forward "$address" "${3:-}"; dispatch "hl.dsp.window.fullscreen({ mode = \"maximized\", window = \"address:$address\" })" ;;
  move)
    [[ ${3:-} =~ ^[1-9][0-9]{0,8}$ ]] || fail 'Choose a workspace.'
    spaces=$(json hyprctl -j workspaces) || fail 'Could not read workspaces.'
    jq -e --argjson id "$3" 'any(.[]; .id == $id)' <<<"$spaces" >/dev/null || fail 'That workspace is no longer available.'
    dispatch "hl.dsp.window.move({ workspace = \"$3\", window = \"address:$address\", follow = false })"
    ;;
  *) fail 'Unknown window action.' ;;
  esac
  done_ok
  ;;
workspace)
  [[ $# == 1 && $1 =~ ^[1-9][0-9]{0,8}$ ]] || fail 'Choose a workspace.'
  spaces=$(json hyprctl -j workspaces) || fail 'Could not read workspaces.'
  jq -e --argjson id "$1" 'any(.[]; .id == $id)' <<<"$spaces" >/dev/null || fail 'That workspace is no longer available.'
  dispatch "hl.dsp.focus({ workspace = \"$1\" })"; done_ok
  ;;
volume)
  [[ $# == 1 ]] || fail 'Choose a volume action.'
  case $1 in
  up) bounded wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+ >/dev/null ;;
  down) bounded wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- >/dev/null ;;
  mute) bounded wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle >/dev/null ;;
  *) fail 'Unknown volume action.' ;;
  esac || fail 'Audio is unavailable.'
  done_ok
  ;;
brightness)
  [[ $# == 2 ]] || fail 'Choose brightness and display.'
  known_monitor "$2"
  case $1 in up) step='+5%' ;; down) step='5%-' ;; *) fail 'Unknown brightness action.' ;; esac
  bounded omarchy-brightness-display --monitor "$2" "$step" >/dev/null || fail 'Brightness is unavailable on this display.'
  done_ok
  ;;
media)
  [[ $# == 1 && $1 =~ ^(previous|play-pause|next)$ ]] || fail 'Unknown playback action.'
  bounded playerctl "$1" >/dev/null || fail 'No active media player.'; done_ok
  ;;
rotation)
  [[ $# == 1 ]] || fail 'Choose a rotation action.'
  catalog=$(plugins) || fail 'Could not discover enabled plugins.'
  enabled andreiyurik.tablet-mode && [[ -x $provider ]] || fail 'Enable Tablet Mode for rotation controls.'
  case $1 in
  lock) bounded "$provider" lock toggle >/dev/null ;;
  left|right|normal) bounded "$provider" rotate "$1" >/dev/null ;;
  *) fail 'Unknown rotation action.' ;;
  esac || fail 'Could not change rotation.'
  done_ok
  ;;
network)
  catalog=$(plugins) || fail 'Could not discover enabled plugins.'
  enabled omarchy.network || fail 'Add the Network panel to your bar first.'
  reply=$(bounded omarchy-shell shell summon omarchy.network '{}') || fail 'Could not open Network.'
  [[ $reply == ok ]] || fail 'Network is unavailable from the current bar.'; done_ok
  ;;
lock)
  bounded omarchy-system-lock >/dev/null || fail 'The lock request failed.'; done_ok
  ;;
*) fail 'Unknown Orb touch operation.' ;;
esac
