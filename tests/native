#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
./tests/run
lua tests/desktop-click.lua
omarchy plugin validate .
# Uses .qmlformat.ini. Run `qmlformat -i *.qml` to fix a reported file.
for file in *.qml; do
  /usr/lib/qt6/bin/qmlformat "$file" | cmp -s - "$file" || { echo "Not qmlformat-clean: $file" >&2; exit 1; }
done
echo 'PASS: installed manifest validator, Qt QML parser and qmlformat layout'
